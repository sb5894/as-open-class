{
  "name": "as-open-class",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "안성초 공개수업·성과보고회 웹사이트",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "check": "tsc --noEmit && npm run check --workspace functions",
    "build": "npm run check && vite build && npm run build --workspace functions",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run test:data && vitest run",
    "test:mobile": "playwright test",
    "test:data": "uv run scripts/convert_data.py --test",
    "data:convert": "uv run scripts/convert_data.py",
    "data:check": "uv run scripts/convert_data.py --check",
    "firebase": "firebase",
    "emulators": "npm run build && firebase emulators:start --only functions,hosting",
    "verify:registration": "npm run build --workspace functions && node scripts/verify-registration-live.mjs",
    "verify:sources": "node scripts/verify-sources.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22",
    "firebase-tools": "15.34.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "5.3.1",
    "pdfjs-dist": "6.4.299"
  }
}
